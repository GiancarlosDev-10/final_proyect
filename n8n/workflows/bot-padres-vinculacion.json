        "jsCode": "const BASE_URL = $env.DASHBOARD_URL;\nconst API_SECRET = $env.TELEGRAM_API_SECRET;\n\nconst chatId = $('PrepararMensaje1').item.json.chatId;\nconst dniEstudiante = $json.inputText;\n\nconst result = await this.helpers.httpRequest({\n  method: 'POST',\n  url: `${BASE_URL}/api/telegram/iniciar-vinculacion-apoderado`,\n  headers: { 'x-api-key': API_SECRET, 'Content-Type': 'application/json' },\n  body: { chatId, dniEstudiante },\n  json: true\n});\n\nreturn { json: { ...result, chatId } };"
      },
