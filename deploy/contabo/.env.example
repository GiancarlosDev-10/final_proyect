# setup-vps.sh genera .env a partir de este archivo y completa los hosts y
# N8N_ENCRYPTION_KEY solo. Los demás valores hay que pegarlos a mano.

# --- Hosts públicos (sslip.io, IP con guiones) ---
N8N_HOST=n8n.1-2-3-4.sslip.io
RECONOCIMIENTO_HOST=rostros.1-2-3-4.sslip.io

# --- n8n ---
# "stable" = última estable. Para fijar versión: p. ej. N8N_VERSION=1.x.y
N8N_VERSION=stable
# NO cambiarla después de crear credenciales en n8n (quedarían ilegibles).
N8N_ENCRYPTION_KEY=

# --- Variables que leen los workflows ($env.X) ---
DASHBOARD_URL=https://colegio-juan-velasco.vercel.app
# Mismo valor que TELEGRAM_API_SECRET en Vercel
TELEGRAM_API_SECRET=
# Mismo valor que N8N_WEBHOOK_SECRET en Vercel
N8N_WEBHOOK_SECRET=
# Token del bot "Bot Manual" (@BotFather), lo usa TranscribirAudio
TELEGRAM_BOT_MANUAL_TOKEN=
# API key de OpenAI, la usa TranscribirAudio (Whisper)
OPENAI_API_KEY=
