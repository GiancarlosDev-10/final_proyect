    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const mensaje = $input.item.json.message;\n\nif (!mensaje) {\n  return { json: { chatId: '', inputText: '', skip: true } };\n}\n\nconst chatId = String(mensaje.chat.id);\nconst texto = mensaje.text ? mensaje.text.trim() : '';\n\nreturn { json: { chatId, inputText: texto, skip: !mensaje.text } };"
      },
      "id": "5ae57fbb-3c93-4f63-b5cc-e73c81fad981",
      "name": "PrepararMensaje1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2256,
        656
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.skip || !$json.inputText) {\n  return { json: { ...$json, intencion: 'DESCONOCIDO' } };\n}\n\n// Limpiar espacios, saltos de línea y caracteres invisibles\nconst textoLimpio = $json.inputText.replace(/\\s+/g, '').trim();\nlet intencion = 'DESCONOCIDO';\n\nif (/^\\d{8}$/.test(textoLimpio)) {\n  intencion = 'DNI';\n} else if (/^\\d{6}$/.test(textoLimpio)) {\n  intencion = 'CODIGO';\n}\n\n// Debug temporal — bórralo después de confirmar que funciona\nconsole.log('textoLimpio:', textoLimpio, '| longitud:', textoLimpio.length, '| intencion:', intencion);\n\nreturn { json: { ...$json, intencion, inputText: textoLimpio } };"
      },
