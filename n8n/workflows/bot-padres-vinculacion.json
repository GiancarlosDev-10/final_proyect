    {
      "parameters": {
        "sendTo": "={{ $json.emailApoderado }}",
        "subject": "Código de verificación - Colegio Juan Velasco Alvarado",
        "message": "=<div style=\"background-color:#f4f4f5; padding:32px 0; font-family:Arial, Helvetica, sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px; margin:0 auto; background-color:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #e5e5e5;\">\n\n    <!-- Header -->\n    <tr>\n      <td style=\"background-color:#1a2b4c; padding:24px 32px; text-align:center;\">\n        <span style=\"color:#ffffff; font-size:20px; font-weight:bold; letter-spacing:0.5px;\">\n          Colegio Juan Velasco Alvarado\n        </span>\n      </td>\n    </tr>\n\n    <!-- Body -->\n    <tr>\n      <td style=\"padding:32px;\">\n        <p style=\"font-size:16px; color:#1a1a1a; margin:0 0 4px 0;\">\n          Hola, <strong>{{ $json.nombreApoderado }}</strong>\n        </p>\n        <p style=\"font-size:15px; color:#444444; line-height:1.5; margin:0 0 24px 0;\">\n          Recibimos una solicitud para vincular tu cuenta de Telegram con el/la estudiante\n          <strong>{{ $json.nombreEstudiante }}</strong>. Ingresa este código en el chat del bot para continuar:\n        </p>\n\n        <!-- Código -->\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n          <tr>\n            <td style=\"background-color:#f0f2f5; border:1px dashed #1a2b4c; border-radius:6px; padding:20px; text-align:center;\">\n              <span style=\"font-size:34px; font-weight:bold; letter-spacing:8px; color:#1a2b4c;\">\n                {{ $json.codigo }}\n              </span>\n            </td>\n          </tr>\n        </table>\n\n        <p style=\"font-size:13px; color:#888888; margin:20px 0 0 0; text-align:center;\">\n          Este código vence en 15 minutos.\n        </p>\n      </td>\n    </tr>\n\n    <!-- Ayuda -->\n    <tr>\n      <td style=\"padding:0 32px 24px 32px;\">\n        <p style=\"font-size:13px; color:#666666; line-height:1.5; margin:0;\">\n          Si no solicitaste este código, puedes ignorar este correo con tranquilidad.\n        </p>\n      </td>\n    </tr>\n\n    <!-- Footer -->\n    <tr>\n      <td style=\"background-color:#f4f4f5; padding:16px 32px; text-align:center; border-top:1px solid #e5e5e5;\">\n        <span style=\"font-size:12px; color:#999999;\">\n          © 2026 Colegio Juan Velasco Alvarado · Este es un mensaje automático, no respondas a este correo.\n        </span>\n      </td>\n    </tr>\n\n  </table>\n</div>",
        "options": {
          "appendAttribution": false
        }
      },
